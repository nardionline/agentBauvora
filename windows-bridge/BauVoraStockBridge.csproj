<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BauVoraStockBridge</AssemblyName>
    <RootNamespace>BauVoraStockBridge</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.json')" />
    <None Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.bauvora.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="baumarket_vora_query.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
